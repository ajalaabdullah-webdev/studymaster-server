# ============================================================
# StudyMaster AI Backend (Python / FastAPI / LangGraph) — V2
# ============================================================
# NOTE: values carried over from the legacy Node backend so the
# new Python service is drop-in compatible with the same MongoDB
# and the same JWT tokens already issued to users.

# --- App ---
ENV=development
PORT=8000
FRONTEND_URL=
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=

# --- Database (same cluster + DB as legacy backend) ---
MONGODB_URI=
MONGODB_DB=studymaster

# --- Auth (MUST match legacy backend so existing tokens keep working) ---
JWT_SECRET=
JWT_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# --- LLM (via LiteLLM router; provider-agnostic) ---
# Default models are LiteLLM model strings. Swap providers by changing these.
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=openai/gpt-4o-mini
LLM_SMART_MODEL=openai/gpt-4o
# Placeholder for when DeepSeek/Kimi keys arrive:
# DEEPSEEK_API_KEY=
# LLM_CHEAP_MODEL=deepseek/deepseek-chat

# --- Google Gemini (Live API — used in Phase 5 live teaching) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- OpenAI note narration ---
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
OPENAI_DECISIONS_MODEL=gpt-6-luna

# --- Spitch (STT dictation only) ---
SPITCH_API_KEY=

# --- Live web research (Tavily) ---
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Google OAuth (Sign in with Google) ---
GOOGLE_CLIENT_ID=

# --- Cloudinary (image uploads: community posts, note image search cache) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin panel ---
ADMIN_PASSWORD=
